<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>KoiPaper</AssemblyName>
    <RootNamespace>KoiPaper</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Koi Paper</Product>
    <Description>Nagomi koi pond as a live Windows wallpaper</Description>
    <!-- The WebView2 package also references its WPF control, which this WinForms app never loads. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="KoiPaper.app.ico" />
  </ItemGroup>

  <!-- The pond itself: the Vite build of ../web (npm run build), served from wwwroot. -->
  <PropertyGroup>
    <WebDist>$(MSBuildProjectDirectory)\..\web\dist\</WebDist>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(WebDist)**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Nagomi is PolyForm Noncommercial: its terms and Required Notice travel with every copy. -->
    <Content Include="..\web\LICENSE" Link="LICENSE-nagomi.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckWebDist" BeforeTargets="Build">
    <Warning Condition="!Exists('$(WebDist)index.html')" Text="web\dist is missing: run 'npm install' and 'npm run build' in ..\web first." />
  </Target>

</Project>
